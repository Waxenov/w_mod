	quest.7BDF3379D09D8B9C.title: "Ёмкость"
	quest.7BEEF193DEA561FC.quest_desc: ["Откройте раздел &6«Маршруты»&r и ознакомьтесь с его заданиями."]
	quest.7C159390E9863377.quest_desc: [
		"Сделай &eинженерные очки&r."
		""
