	quest.6CA0A75490DDFF53.title: "Стальной снаряд"
	quest.6CABF17378193F9A.quest_desc: ["Подай &bводу&r в &eбак&r как жидкость!"]
	quest.6CABF17378193F9A.quest_subtitle: "Не просто ведро"
	quest.6CABF17378193F9A.title: "Вода как жидкость"
