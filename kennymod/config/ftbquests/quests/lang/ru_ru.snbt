	quest.68432C6B3DEFF03F.quest_desc: ["Создайте предмет &eБронебойное (ББ) ядро&r."]
	quest.68E411CF08DD94BD.quest_desc: ["Создайте предмет &eМиномётный камень&r."]
	quest.692A3E8D1E106BF1.quest_desc: ["Подготовь запас зелий для осадных боёв."]
	quest.692A3E8D1E106BF1.quest_subtitle: "Перед боем"
	quest.692A3E8D1E106BF1.title: "Запас зелий"
	quest.692C9B4AFFC51E7E.quest_desc: ["Создайте &eпустотный горн&r."]
	quest.6946D455E160908A.quest_desc: ["Создайте &eкатализатор сжатия&r."]
	quest.6946D455E160908A.quest_subtitle: "сжимает всё! (расходуется при крафте)"
