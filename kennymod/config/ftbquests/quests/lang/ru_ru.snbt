	quest.7D1D51F0487E90D0.title: "Пропеллерный подшипник"
	quest.7D24F9A58ABC66AB.quest_desc: ["Добавь &eсимметричный парус&r к корпусу будущего &6корабля&r."]
	quest.7D24F9A58ABC66AB.quest_subtitle: "Подъёмная мощь"
	quest.7D24F9A58ABC66AB.title: "Парусина"
	quest.7D30F301CF13F0AF.quest_desc: ["Выбери первую цель Cataclysm и подготовь оружие, защиту и снабжение."]
