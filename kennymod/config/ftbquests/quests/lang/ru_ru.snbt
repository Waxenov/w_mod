	quest.7DD42E1BF69EC61B.quest_subtitle: "Производство питается"
	quest.7DD42E1BF69EC61B.title: "Реактор подключён"
	quest.7DD9501841D8CAB0.quest_desc: ["Запусти точку у среднего пояса. Отсюда должны идти свинец, железо и золото для новых глав."]
	quest.7DD9501841D8CAB0.quest_subtitle: "Свинец партиями"
	quest.7DD9501841D8CAB0.title: "Средняя добывающая точка"
