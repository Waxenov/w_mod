	quest.69934FB231512DC0.title: "Кокосовое волокно"
	quest.69C4B8D2E9C3D987.quest_desc: ["Создайте предмет &eТвёрдое нитро&r."]
	quest.69DD9D7720A875EA.quest_desc: ["Сделай смесь левитита."]
	quest.69DD9D7720A875EA.quest_subtitle: "Первый материал позднего полёта"
	quest.69DD9D7720A875EA.title: "Смесь левитита"
	quest.69F952FBA16831CF.quest_desc: ["Создайте &eнагрудник Соколиного гнезда-AS&r."]
	quest.6A14EDB34834FAB0.quest_desc: ["Найди дремлющую расплавленную жилу скории и подготовь безопасный маршрут к ней."]
	quest.6A14EDB34834FAB0.quest_subtitle: "Глубокий след"
	quest.6A14EDB34834FAB0.title: "Дремлющая скория"
	quest.6A67629D8A0ED7B3.quest_desc: ["Подготовьте еду, яблоки и стрелы перед порталом и боссами."]
	quest.6A67629D8A0ED7B3.quest_subtitle: "Запас перед финалом"
	quest.6A67629D8A0ED7B3.title: "Финальные расходники"
	quest.6A9AFC32DF460CE4.quest_desc: ["Для заталкивания снарядов используйте &eприбойник&r, а для извлечения боеприпасов — &eбур&r."]
	quest.6ABB92A9EA794A59.quest_desc: [
		"Создайте &eвозвратную пружину&r для автопушки."
		""
		"Она нужна, когда важнее &6скорострельность&r, а не сила взрыва или пробивная способность."
	]
	quest.6AC45A5ED7787C77.quest_desc: ["Создайте предмет &eВзрыватель замедленного действия&r."]
	quest.6AE2CFBE0CFBE922.quest_desc: ["Сдавай охладители после сборки контура. Реактору нужен запас охлаждения до загрузки топлива."]
	quest.6AE2CFBE0CFBE922.quest_subtitle: "Контур крепче"
	quest.6AE2CFBE0CFBE922.title: "Поставка: охладители"
	quest.6AE57230F2EC2D02.quest_desc: [
		"Подготовь несколько &eдепо&r заранее."
		""
		"Тебе это пригодится, обещаю! И вот &eламинарии&r в подарок!"
	]
	quest.6AE57230F2EC2D02.quest_subtitle: "Небольшой запас"
	quest.6AE57230F2EC2D02.title: "Запас депо"
	quest.6B1E00D6F7879673.quest_desc: ["Построй точку у свинцового пояса. Свинец нужен для защиты и реакторных материалов, поэтому его лучше возить партиями."]
	quest.6B1E00D6F7879673.quest_subtitle: "Тяжёлый ресурс"
	quest.6B1E00D6F7879673.title: "Свинцовая точка"
	quest.6B703EA585354F81.quest_desc: ["Собери комплект сплавных пластин и набор бронепластин для тяжёлых боёв."]
	quest.6B703EA585354F81.quest_subtitle: "Комплект пластин"
	quest.6B703EA585354F81.title: "Сплавная броня"
	quest.6BD4E9CF1ACCE386.quest_desc: ["Создайте следующие предметы: &eСтальной винтовой затвор&r, &eСтальной скорострельный затвор&r, &eСтальной скользящий затвор&r, &eТолстая стальная пушечная камера&r, &eСоставная стальная пушечная камера&r, &eСтальная пушечная камера&r, &eСоставной стальной пушечный ствол&r и &eСтальной пушечный ствол&r."]
	quest.6BFC57C078FB54C9.quest_desc: ["Сделай индукционный механизм из урановых стержней, графита и медной обмотки."]
	quest.6BFC57C078FB54C9.quest_subtitle: "Магнитная стадия"
	quest.6BFC57C078FB54C9.title: "Индукционный механизм"
	quest.6C018187903C8A11.quest_desc: ["Создайте &eрасплату душ&r."]
	quest.6C0C95D65EF2C552.quest_desc: ["Создайте следующие предметы: &eЧугунная пушечная заглушка&r, &eЧугунный пушечный ствол&r, &eЧугунная пушечная камера&r, &eЧугунный скорострельный затвор&r и &eЧугунный скользящий затвор&r."]
	quest.6C0C95D65EF2C552.quest_subtitle: "Поздравляю с первой пушкой!"
	quest.6C2A82637D0AE4E8.quest_desc: ["Собери ключевые механизмы этой главы вместе. Реактор появится позже: сейчас важны герметизация, индукция и точное управление."]
	quest.6C2A82637D0AE4E8.quest_subtitle: "Не забегать вперёд"
	quest.6C2A82637D0AE4E8.title: "Комплект без реактора"
	quest.6C49AD35A049D9CF.quest_desc: ["Создайте &eигровой диск&r."]
	quest.6C6CFDEF3F9F8853.quest_desc: ["Передайте &eжелезный лист&r."]
