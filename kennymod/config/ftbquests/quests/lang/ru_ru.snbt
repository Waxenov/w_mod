	quest.6C80E8C15A7F4FE9.quest_desc: ["Поставляйте андезитовые корпуса из мастерской через Экран задач."]
	quest.6C80E8C15A7F4FE9.quest_subtitle: "Старые детали"
	quest.6C80E8C15A7F4FE9.title: "Поставка: андезитовые корпуса"
